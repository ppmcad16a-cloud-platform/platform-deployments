# Copy to .env (which is git-ignored) and fill in. LOCAL TESTING ONLY -
# never reuse these values in the cloud.

# Shared JWT signing key for all services - at least 32 characters.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Admin account created by the seed job.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# info (Node) / INFO (Java, Python) by default
# LOG_LEVEL=info
